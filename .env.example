# Whop API and OAuth Configuration
WHOP_API_KEY=whop_api_key_test_12345
NEXT_PUBLIC_WHOP_CLIENT_ID=app_test_client_id
WHOP_CLIENT_SECRET=app_test_client_secret
WHOP_REDIRECT_URI=http://localhost:3000/api/auth/callback
WHOP_WEBHOOK_SECRET=webhook_secret_test_xyz

# Whop Product / Plan Access Check
WHOP_REQUIRED_PLAN_IDS=plan_starter_xxx,plan_pro_xxx

# Session Secret (min 32 bytes random secret for signing JWT cookies)
SESSION_SECRET=your_32_plus_bytes_random_session_secret_base64

# Local Development Bypass (ONLY valid in non-production environments when NODE_ENV !== "production")
# NEVER set this to true in production
DEV_BYPASS_ENABLED=false

