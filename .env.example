# Dodo Payments Configuration
# Environment: 'live' or 'test' (defaults to 'live')
DODO_PAYMENTS_ENVIRONMENT=live
# Optional: Dodo Payments API Key and Webhook Secret
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# Master Passkey for Testing & Promo Video Recording
MASTER_PASSKEY=DEMO-DODO-2026

# Session Secret (min 32 bytes random secret for signing JWT cookies)
SESSION_SECRET=your_32_plus_bytes_random_session_secret_base64

# Google Gemini API Key for AI Lead Audit & Scope Creep Shield
# (Can also be configured by users directly in the UI Settings Drawer)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Development Bypass (ONLY valid when NODE_ENV !== "production")
DEV_BYPASS_ENABLED=false

# Legacy / Optional Whop API Configuration (Dual Compatibility)
WHOP_API_KEY=
